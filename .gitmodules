[submodule "flatbuffers"]
	path = deps/flatbuffers
	url = https://github.com/google/flatbuffers.git
[submodule ".cicd"]
	path = .cicd
	url = https://github.com/wamp-proto/wamp-cicd.git
[submodule ".ai"]
	path = .ai
	url = https://github.com/wamp-proto/wamp-ai.git
[submodule "lmdb-upstream"]
	path = lmdb-upstream
	url = https://github.com/LMDB/lmdb.git
[submodule ".autobahn-crossbar-ai"]
	path = .autobahn-crossbar-ai
	url = https://github.com/crossbario/autobahn-crossbar-ai.git
